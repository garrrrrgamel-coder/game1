                lastX = pos.x; lastY = pos.y;
                return;
            }

            if (!draggedSlime) return;
            draggedSlime.x = pos.x;
            draggedSlime.y = pos.y;
            lastX = pos.x; lastY = pos.y;
        }

        function endDrag(e) {
            if (!draggedSlime) return;
            if (mixingPair) { draggedSlime = null; return; }

            for (let i = 0; i < activeSlimes.length; i++) {
                let other = activeSlimes[i];
                if (other === draggedSlime) continue;

                let dist = Math.hypot(draggedSlime.x - other.x, draggedSlime.y - other.y);
                if (dist < (draggedSlime.radius + other.radius) * 0.8) {
                    let key = draggedSlime.id + "_" + other.id;
                    if (recipes[key]) {
                        mixingPair = {
                            slime1: draggedSlime,
                            slime2: other,
                            resultId: recipes[key],
                            x: (draggedSlime.x + other.x) / 2,
                            y: (draggedSlime.y + other.y) / 2
                        };
                        mixProgress = 0;
                        break;
                    }
                }
            }
            if (draggedSlime) {
                draggedSlime.vx = (Math.random() - 0.5) * 0.8;
                draggedSlime.vy = (Math.random() - 0.5) * 0.8;
            }
            draggedSlime = null;
        }

                // Интеллектуальный мост: переводим мобильный тач в мышку без задержек браузера
                function handleTouch(e, mouseEventName) {
            const modal1 = document.getElementById("collection-modal");
            const modal2 = document.getElementById("shop-modal");
            let isMenuOpen = (modal1 && modal1.style.display === "flex") || (modal2 && modal2.style.display === "flex");

            if (isMenuOpen) {
                return; 
            }

            if (e.touches.length > 0) {
                const touch = e.touches[0];
                const mouseEvent = new MouseEvent(mouseEventName, {
                    clientX: touch.clientX,
                    clientY: touch.clientY
                });
                canvas.dispatchEvent(mouseEvent);
            }
            if (e.cancelable) e.preventDefault(); 
        }

        canvas.addEventListener('touchstart', function(e) { handleTouch(e, 'mousedown'); }, { passive: false });
        canvas.addEventListener('touchmove', function(e) { handleTouch(e, 'mousemove'); }, { passive: false });
        canvas.addEventListener('touchend', function(e) { endDrag(e); }, { passive: false });
        
        canvas.addEventListener('mousedown', startDrag);
        canvas.addEventListener('mousemove', moveDrag);
        canvas.addEventListener('mouseup', endDrag);

                      function gameLoop() {
            ctx.clearRect(0, 0, canvas.width, canvas.height);

            // --- СИСТЕМА ДИНАМИЧЕСКИХ ЖИВЫХ СПЕЦЭФФЕКТОВ ДЛЯ ФОНОВ ---
            if (!window.bgParticles) {
                // Создаём массив частиц один раз при старте игры
                window.bgParticles = [];
                for (let i = 0; i < 20; i++) {
                    window.bgParticles.push({
                        x: Math.random() * canvas.width,
                        y: Math.random() * canvas.height,
                        size: 1 + Math.random() * 4,
                        speed: 0.3 + Math.random() * 0.8,
                        alpha: 0.2 + Math.random() * 0.6,
                        seed: Math.random() * 100
                    });
                }
            }

            // Отрисовка уникальных частиц под текущую локацию
            if (currentBgId === "bg_magma" || currentBgId === "bg_alien" || currentBgId === "bg_cyber") {
                window.bgParticles.forEach(p => {
                    // Частицы плавно плывут вверх
                    p.y -= p.speed;
                    if (p.y < 80) { // Возвращаем частицы вниз экрана, когда они улетают
                        p.y = canvas.height;
                        p.x = Math.random() * canvas.width;
                    }

                    ctx.save();
                    ctx.beginPath();

                    if (currentBgId === "bg_magma") {
                        // Магма: рисуем раскалённые, мерцающие огненные искры
                        let pulse = Math.sin(Date.now() * 0.003 + p.seed) * 2;
                        ctx.arc(p.x, p.y, Math.max(1, p.size + pulse), 0, Math.PI * 2);
                        ctx.fillStyle = `rgba(255, ${70 + Math.floor(Math.sin(p.seed)*40)}, 0, ${p.alpha})`;
                        ctx.shadowBlur = 15;
                        ctx.shadowColor = "#ff4500";
                    } 
                    else if (currentBgId === "bg_alien") {
                        // Пришельцы: круглые радиоактивные пузырьки, которые покачиваются вбок
                        p.x += Math.sin(Date.now() * 0.002 + p.seed) * 0.2;
                        ctx.arc(p.x, p.y, p.size * 1.5, 0, Math.PI * 2);
                        ctx.fillStyle = `rgba(0, 255, 100, ${p.alpha * 0.4})`;
                        ctx.strokeStyle = `rgba(0, 255, 100, ${p.alpha * 0.7})`;
                        ctx.lineWidth = 1;
                        ctx.stroke();
                    } 
                    else if (currentBgId === "bg_cyber") {
                        // Кибер-фон: строгие квадратные пиксели-импульсы данных
                        ctx.rect(p.x, p.y, 3, 6);
                        ctx.fillStyle = `rgba(0, 246, 255, ${p.alpha * 0.6})`;
                        ctx.shadowBlur = 10;
                        ctx.shadowColor = "#00f6ff";
                    }

                    ctx.fill();
                    ctx.restore();
                });
            }

            activeSlimes.forEach(slime => {
                if (mixingPair && (slime === mixingPair.slime1 || slime === mixingPair.slime2)) {
                    return;
                }

                                if (slime !== draggedSlime) {
                    // Эффект густого сиропа: постоянно слегка притормаживаем слаймы
                    slime.vx *= 0.995;
                    slime.vy *= 0.995;

                    slime.x += slime.vx;
                    slime.y += slime.vy;
                    
                    // Плавный отскок от стен без ускорения
                    if (slime.x - slime.radius < 0) { slime.x = slime.radius; slime.vx *= -0.8; }
                    if (slime.x + slime.radius > canvas.width) { slime.x = canvas.width - slime.radius; slime.vx *= -0.8; }
                    if (slime.y - slime.radius < 80) { slime.y = 80 + slime.radius; slime.vy *= -0.8; }
                    if (slime.y + slime.radius > canvas.height) { slime.y = canvas.height - slime.radius; slime.vy *= -0.8; }
                }
                                // --- МЯГКАЯ ФИЗИКА СТОЛКНОВЕНИЯ И ОТТАЛКИВАНИЯ ЖЕЛЕ ---
                activeSlimes.forEach(other => {
                    if (slime === other || (mixingPair && (slime === mixingPair.slime1 || slime === mixingPair.slime2 || other === mixingPair.slime1 || other === mixingPair.slime2))) return;
                    
                    let dx = other.x - slime.x;
                    let dy = other.y - slime.y;
                    let distance = Math.hypot(dx, dy);
                    let minDist = slime.radius + other.radius;

                    if (distance < minDist) {
                        // УМНЫЙ ТРИГГЕР: Если мы тащим слайм на другой и для них ЕСТЬ рецепт — НЕ расталкиваем их!
                        if (slime === draggedSlime || other === draggedSlime) {
                            let key1 = slime.id + "_" + other.id;
                            let key2 = other.id + "_" + slime.id;
                            if (recipes[key1] || recipes[key2]) return; // Пропускаем физику, давая им сочно слиться!
                        }

                        let overlap = minDist - distance;
                        let angle = Math.atan2(dy, dx);
                        let force = overlap * 0.12; // Возвращаем хорошую упругость

                        // Передаем силу сжатия желе в радиус точек
                        slime.radiusWave = (slime.radiusWave || 0) - overlap * 0.25;
                        other.radiusWave = (other.radiusWave || 0) - overlap * 0.25;

                        if (slime !== draggedSlime) {
                            slime.x -= Math.cos(angle) * (overlap * 0.5);
                            slime.y -= Math.sin(angle) * (overlap * 0.5);
                            slime.vx -= Math.cos(angle) * force;
                            slime.vy -= Math.sin(angle) * force;
                        }
                        if (other !== draggedSlime) {
                            other.x += Math.cos(angle) * (overlap * 0.5);
                            other.y += Math.sin(angle) * (overlap * 0.5);
                            other.vx += Math.cos(angle) * force;
                            other.vy += Math.sin(angle) * force;
                        }
                    }
                });

                // Пружинное восстановление формы амёбы после удара
                slime.radiusWave = (slime.radiusWave || 0) * 0.85;


                ctx.save(); // Сохраняем состояние холста для конкретного слайма

                ctx.beginPath();
                // --- НАСТОЯЩАЯ ИДЕАЛЬНО ПЛАВНАЯ АМЁБА ---
                let points = [];
                let time = Date.now() * 0.003; 
                let speed = Math.min(Math.hypot(slime.vx, slime.vy), 3);
                if (slime === draggedSlime) speed = 3.5;
                let moveAngle = Math.atan2(slime.vy, slime.vx);

                for (let i = 0; i < 8; i++) {
                    let angle = (Math.PI * 2 / 8) * i;
                    let wave = Math.sin(time + i * 1.0) * 24; 
                    let stretch = Math.cos(angle - moveAngle) * (speed * 4); 
                    let r = slime.radius + stretch + wave + (slime.radiusWave || 0);
                    points.push({
                        x: slime.x + Math.cos(angle) * r,
                        y: slime.y + Math.sin(angle) * r
                    });
                }

                ctx.moveTo((points[0].x + points[points.length - 1].x) / 2, (points[0].y + points[points.length - 1].y) / 2);
                for (let i = 0; i < points.length; i++) {
                    let next = points[(i + 1) % points.length];
                    let xc = (points[i].x + next.x) / 2;
                    let yc = (points[i].y + next.y) / 2;
                    ctx.quadraticCurveTo(points[i].x, points[i].y, xc, yc);
                }
                ctx.closePath();
                
                let data = slimesDB[slime.id];
                if (data.color === 'rainbow') {
                    let grad = ctx.createRadialGradient(slime.x, slime.y, 0, slime.x, slime.y, slime.radius);
                    grad.addColorStop(0, 'red'); grad.addColorStop(0.2, 'orange'); grad.addColorStop(0.4, 'yellow');
                    grad.addColorStop(0.6, 'green'); grad.addColorStop(0.8, 'blue'); grad.addColorStop(1, 'purple');
                    ctx.fillStyle = grad;
                } else {
                    ctx.fillStyle = data.color;
                }

                ctx.shadowBlur = 35;
                ctx.shadowColor = data.color === 'rainbow' ? '#ff00ff' : data.color;
                ctx.fill();
                ctx.shadowBlur = 0;

                // --- ИЗОЛИРОВАННАЯ СИСТЕМА БЛЁСТОК ДЛЯ РЕДКИХ СЛАЙМОВ ---
                if (slime.id === 12 || (slime.id >= 16 && slime.id <= 24)) {
                    ctx.clip(); // Обрезаем строго внутри текущей амёбы
                    for (let j = 0; j < 6; j++) {
                        let sparkX = slime.x + Math.sin(Date.now() * 0.002 + j * 50) * (slime.radius * 0.5);
                        let sparkY = slime.y + Math.cos(Date.now() * 0.0015 + j * 30) * (slime.radius * 0.5);
                        let sparkSize = 1.5 + Math.sin(Date.now() * 0.01 + j) * 1;
                        
                        ctx.beginPath();
                        ctx.arc(sparkX, sparkY, Math.max(0.5, sparkSize), 0, Math.PI * 2);
                        ctx.fillStyle = slime.id === 12 ? (j % 2 === 0 ? "#ff00ff" : "#00f0ff") : "#ffffff";
                        ctx.shadowBlur = 10;
                        ctx.shadowColor = ctx.fillStyle;
                        ctx.fill();
                    }
                }

                ctx.restore(); // Полностью сбрасываем маску обрезки для следующего слайма
            });

            if (mixingPair) {
                let angle = (mixProgress * 0.15) + (Date.now() * 0.002);
                let orbitRadius = 24 * (1 - mixProgress / 100);

                mixingPair.slime1.x = mixingPair.x + Math.cos(angle) * orbitRadius;
                mixingPair.slime1.y = mixingPair.y + Math.sin(angle) * orbitRadius;
                mixingPair.slime2.x = mixingPair.x + Math.cos(angle + Math.PI) * orbitRadius;
                mixingPair.slime2.y = mixingPair.y + Math.sin(angle + Math.PI) * orbitRadius;

                let jellyWave = Math.sin(Date.now() * 0.01) * 3;
                mixingPair.slime1.currentRadius = mixingPair.slime1.radius + jellyWave;
                mixingPair.slime2.currentRadius = mixingPair.slime2.radius - jellyWave;

                let s1 = mixingPair.slime1;
                let s2 = mixingPair.slime2;
                let data1 = slimesDB[s1.id];
                let data2 = slimesDB[s2.id];
                let resultData = slimesDB[mixingPair.resultId];

                let mixRadius = Math.max(s1.radius, s2.radius) * (1.1 + mixProgress / 200);
                
                ctx.beginPath();
                ctx.arc(mixingPair.x, mixingPair.y, mixRadius, 0, Math.PI * 2);

                let radGrad = ctx.createRadialGradient(
                    mixingPair.x, mixingPair.y, 0, 
                    mixingPair.x, mixingPair.y, mixRadius
                );

                let c1 = data1.color === 'rainbow' ? '#ff00ff' : data1.color;
                let c2 = data2.color === 'rainbow' ? '#00ffff' : data2.color;
                let targetColor = resultData.color === 'rainbow' ? '#ff00ff' : resultData.color;

                let coreSize = mixProgress / 100;
                
                radGrad.addColorStop(0, targetColor);
                radGrad.addColorStop(Math.min(0.8, coreSize * 0.6), targetColor);
                
                if (Math.sin(angle) > 0) {
                    radGrad.addColorStop(0.6, c1);
                    radGrad.addColorStop(1, c2);
                } else {
                    radGrad.addColorStop(0.6, c2);
                    radGrad.addColorStop(1, c1);
                }

                ctx.fillStyle = radGrad;
                ctx.shadowBlur = 35;
                ctx.shadowColor = targetColor;
                ctx.fill();
                ctx.shadowBlur = 0;

                ctx.beginPath();
                ctx.arc(mixingPair.x, mixingPair.y, 75, 0, Math.PI * 2);
                ctx.strokeStyle = "rgba(255, 255, 255, 0.08)";
                ctx.lineWidth = 8;
                ctx.stroke();

                ctx.beginPath();
                ctx.arc(mixingPair.x, mixingPair.y, 75, -Math.PI / 2, (-Math.PI / 2) + (Math.PI * 2 * (mixProgress / 100)));
                ctx.strokeStyle = "#00f6ff";
                ctx.lineWidth = 8;
                ctx.shadowBlur = 20;
                ctx.shadowColor = "#00f6ff";
                ctx.stroke();
                ctx.shadowBlur = 0;

                ctx.font = "bold 16px sans-serif";
                ctx.fillStyle = "#ffcc00";
                ctx.fillText("КРУТИ ПАЛЬЦЕМ! 🌀", mixingPair.x, mixingPair.y - 95);
            }

            requestAnimationFrame(gameLoop);
        }
        gameLoop();

